<main class="app-shell">
  <section class="dashboard-shell">
    <header class="hero-card">
      <div class="hero-grid">
        <div>
          <p class="eyebrow">Symphony Admin</p>
          <h1 class="hero-title"><%= @workflow.name %></h1>
          <p class="hero-copy">Workflow runtime snapshot and connection summary.</p>
        </div>
      </div>
    </header>

    <section class="metric-grid">
      <article class="metric-card">
        <p class="metric-label">Status</p>
        <p class="metric-value"><%= @workflow.status %></p>
      </article>

      <article class="metric-card">
        <p class="metric-label">Tracker</p>
        <p class="metric-value"><%= @workflow.tracker_connection.kind %></p>
      </article>

      <article class="metric-card">
        <p class="metric-label">Agent</p>
        <p class="metric-value"><%= @workflow.agent_connection.kind %></p>
      </article>

      <article class="metric-card">
        <p class="metric-label">Running</p>
        <p class="metric-value numeric"><%= @snapshot[:counts][:running] %></p>
      </article>

      <article class="metric-card">
        <p class="metric-label">Total tokens</p>
        <p class="metric-value numeric"><%= number_with_delimiter(@snapshot[:codex_totals][:total_tokens]) %></p>
      </article>

      <article class="metric-card">
        <p class="metric-label">Runtime</p>
        <p class="metric-value numeric"><%= format_runtime(@snapshot[:codex_totals][:seconds_running]) %></p>
      </article>
    </section>

    <section class="section-card">
      <div class="section-header">
        <div>
          <h2 class="section-title">Operator controls</h2>
          <p class="section-copy">Pause or resume recurring triggers, or enqueue an immediate refresh.</p>
        </div>
      </div>

      <div class="workflow-actions">
        <% if @workflow.status == "active" %>
          <%= button_to "Refresh now", "/workflows/#{@workflow.id}/refresh_now", method: :post %>
          <%= button_to "Pause workflow", "/workflows/#{@workflow.id}/pause", method: :post, class: "secondary" %>
        <% else %>
          <%= button_to "Resume workflow", "/workflows/#{@workflow.id}/resume", method: :post %>
          <%= button_to "Refresh now", "/workflows/#{@workflow.id}/refresh_now", method: :post, disabled: true, class: "secondary" %>
          <p class="section-copy">Paused workflows do not receive recurring poll or webhook triggers.</p>
        <% end %>
      </div>
    </section>

    <section class="section-card">
      <div class="section-header">
        <div>
          <h2 class="section-title">Trigger health</h2>
          <p class="section-copy">Latest trigger provenance and workflow tick result.</p>
        </div>
      </div>

      <div class="health-grid">
        <div class="health-cell">
          <span class="metric-label">Last trigger source</span>
          <span class="mono"><%= @orchestrator_state&.last_trigger_source || "n/a" %></span>
        </div>
        <div class="health-cell">
          <span class="metric-label">Last triggered at</span>
          <span class="mono"><%= @orchestrator_state&.last_triggered_at&.iso8601 || "n/a" %></span>
        </div>
        <div class="health-cell">
          <span class="metric-label">Last tick status</span>
          <span><%= @orchestrator_state&.last_tick_status || "n/a" %></span>
        </div>
        <div class="health-cell">
          <span class="metric-label">Last tick error</span>
          <span><%= @orchestrator_state&.last_tick_error || "n/a" %></span>
        </div>
      </div>
    </section>

    <section class="section-card">
      <div class="section-header">
        <div>
          <h2 class="section-title">Connections</h2>
          <p class="section-copy">Tracker and agent records currently bound to this workflow.</p>
        </div>
      </div>

      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Type</th>
              <th>Name</th>
              <th>Kind</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Tracker</td>
              <td><%= @workflow.tracker_connection.name %></td>
              <td><%= @workflow.tracker_connection.kind %></td>
              <td><%= @workflow.tracker_connection.status %></td>
            </tr>
            <tr>
              <td>Agent</td>
              <td><%= @workflow.agent_connection.name %></td>
              <td><%= @workflow.agent_connection.kind %></td>
              <td><%= @workflow.agent_connection.status %></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="section-card">
      <div class="section-header">
        <div>
          <h2 class="section-title">Capabilities</h2>
          <p class="section-copy">Tracker capabilities currently available for this workflow.</p>
        </div>
      </div>

      <p class="mono"><%= @capabilities.join(", ") %></p>
      <% if @capabilities.include?(:create_issue) %>
        <p><%= link_to "Manage issues", "/workflows/#{@workflow.id}/issues" %></p>
      <% end %>
    </section>

    <section class="section-card">
      <div class="section-header">
        <div>
          <h2 class="section-title">Recent trigger events</h2>
          <p class="section-copy">Recent accepted, rejected, and failed trigger requests for this workflow.</p>
        </div>
      </div>

      <% if @trigger_events.empty? %>
        <p class="empty-state">No trigger events yet.</p>
      <% else %>
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Source</th>
                <th>Status</th>
                <th>Requested</th>
                <th>Error</th>
              </tr>
            </thead>
            <tbody>
              <% @trigger_events.each do |event| %>
                <tr>
                  <td><%= event.source %></td>
                  <td><%= event.status %></td>
                  <td class="mono"><%= event.requested_at&.iso8601 || "n/a" %></td>
                  <td><%= event.error || "n/a" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </section>

    <section class="section-card">
      <div class="section-header">
        <div>
          <h2 class="section-title">Running sessions</h2>
          <p class="section-copy">Current running entries for this workflow.</p>
        </div>
      </div>

      <% if @snapshot[:running].empty? %>
        <p class="empty-state">No active sessions.</p>
      <% else %>
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Issue</th>
                <th>State</th>
              </tr>
            </thead>
            <tbody>
              <% @snapshot[:running].each do |entry| %>
                <tr>
                  <td><%= entry[:issue_identifier] %></td>
                  <td><%= entry[:state] %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </section>

    <section class="section-card">
      <div class="section-header">
        <div>
          <h2 class="section-title">Retry queue</h2>
          <p class="section-copy">Current retry entries for this workflow.</p>
        </div>
      </div>

      <% if @snapshot[:retrying].empty? %>
        <p class="empty-state">No retry entries.</p>
      <% else %>
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Issue</th>
                <th>Attempt</th>
                <th>Error</th>
              </tr>
            </thead>
            <tbody>
              <% @snapshot[:retrying].each do |entry| %>
                <tr>
                  <td><%= entry[:issue_identifier] %></td>
                  <td><%= entry[:attempt] %></td>
                  <td><%= entry[:error] %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </section>

    <section class="section-card">
      <div class="section-header">
        <div>
          <h2 class="section-title">Recent attempts</h2>
          <p class="section-copy">Latest persisted run attempts for this workflow.</p>
        </div>
      </div>

      <% if @recent_attempts.empty? %>
        <p class="empty-state">No attempts yet.</p>
      <% else %>
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Issue</th>
                <th>Attempt</th>
                <th>Status</th>
                <th>Error</th>
              </tr>
            </thead>
            <tbody>
              <% @recent_attempts.each do |attempt| %>
                <tr>
                  <td><%= attempt.persisted_issue&.identifier || attempt.issue_id %></td>
                  <td><%= attempt.attempt %></td>
                  <td><%= attempt.status %></td>
                  <td><%= attempt.error || "n/a" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </section>
  </section>
</main>
