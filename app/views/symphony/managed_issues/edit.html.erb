<main class="app-shell">
  <section class="dashboard-shell">
    <header class="hero-card">
      <div class="hero-grid">
        <div>
          <p class="eyebrow">Symphony Admin</p>
          <h1 class="hero-title">Edit managed issue</h1>
          <p class="hero-copy">Update a managed issue in the database tracker ledger.</p>
        </div>
      </div>
    </header>

    <section class="section-card">
      <% if @managed_issue.errors.any? %>
        <div class="empty-state">
          <% @managed_issue.errors.full_messages.each do |message| %>
            <p><%= message %></p>
          <% end %>
        </div>
      <% end %>

      <%= form_with model: @managed_issue, url: "/workflows/#{@workflow.id}/issues/#{@managed_issue.id}", method: :patch do |form| %>
        <div>
          <%= form.label :identifier %>
          <%= form.text_field :identifier %>
        </div>

        <div>
          <%= form.label :title %>
          <%= form.text_field :title %>
        </div>

        <div>
          <%= form.label :description %>
          <%= form.text_area :description %>
        </div>

        <div>
          <%= form.label :priority %>
          <%= form.text_field :priority %>
        </div>

        <div>
          <%= form.label :state %>
          <%= form.text_field :state %>
        </div>

        <%= form.submit "Update managed issue" %>
      <% end %>
    </section>
  </section>
</main>
