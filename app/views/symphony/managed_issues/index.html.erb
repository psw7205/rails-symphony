<main class="app-shell">
  <section class="dashboard-shell">
    <header class="hero-card">
      <div class="hero-grid">
        <div>
          <p class="eyebrow">Symphony Admin</p>
          <h1 class="hero-title"><%= @workflow.name %> issues</h1>
          <p class="hero-copy">Managed issues stored in the database tracker ledger.</p>
        </div>
      </div>
    </header>

    <section class="section-card">
      <% if @managed_issues.empty? %>
        <p class="empty-state">No managed issues.</p>
      <% else %>
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Issue</th>
                <th>Title</th>
                <th>State</th>
              </tr>
            </thead>
            <tbody>
              <% @managed_issues.each do |issue| %>
                <tr>
                  <td><%= issue.identifier %></td>
                  <td><%= issue.title %></td>
                  <td><%= issue.state %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </section>
  </section>
</main>
