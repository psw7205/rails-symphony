<main class="app-shell">
  <section class="dashboard-shell">
    <header class="hero-card">
      <div class="hero-grid">
        <div>
          <p class="eyebrow">Symphony Admin</p>
          <h1 class="hero-title"><%= @workflow.name %> issues</h1>
          <p class="hero-copy">Managed issues stored in the database tracker ledger.</p>
        </div>
      </div>
    </header>

    <section class="section-card">
      <div class="section-header">
        <div>
          <h2 class="section-title">Managed issues</h2>
          <p class="section-copy">Create, update, and remove database-tracked issues for this workflow.</p>
        </div>

        <%= link_to "New managed issue", "/workflows/#{@workflow.id}/issues/new" %>
      </div>

      <% if @managed_issues.empty? %>
        <p class="empty-state">No managed issues.</p>
      <% else %>
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Issue</th>
                <th>Title</th>
                <th>State</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @managed_issues.each do |issue| %>
                <tr>
                  <td><%= issue.identifier %></td>
                  <td><%= issue.title %></td>
                  <td><%= issue.state %></td>
                  <td>
                    <%= link_to "Edit", "/workflows/#{@workflow.id}/issues/#{issue.id}/edit" %>
                    <%= button_to "Delete", "/workflows/#{@workflow.id}/issues/#{issue.id}", method: :delete %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </section>
  </section>
</main>
